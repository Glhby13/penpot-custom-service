{
  "info": {
    "name": "Penpot gateway anonymous security regression",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "https://uxstudio.lab.local"
    }
  ],
  "item": [
    {
      "name": "Capabilities deny anonymous",
      "request": {
        "method": "GET",
        "url": "{{base}}/auth-ui/capabilities",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Anonymous has no MCP capability\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().mcp).to.equal(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "MCP stream denies missing token",
      "request": {
        "method": "POST",
        "url": "{{base}}/mcp/stream",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "MCP stream rejects forged token",
      "request": {
        "method": "POST",
        "url": "{{base}}/mcp/stream?userToken=forged",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "MCP WebSocket rejects missing token",
      "request": {
        "method": "GET",
        "url": "{{base}}/mcp/ws",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Password guard retained",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/rpc/command/update-profile-password",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Registration remains blocked",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/rpc/command/register-profile",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Managed email cannot change",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/rpc/command/request-email-change",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Token creation refuses anonymous",
      "request": {
        "method": "POST",
        "url": "{{base}}/api/rpc/command/create-access-token",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"abuse\",\"type\":\"mcp\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Legacy token listing refuses anonymous",
      "request": {
        "method": "GET",
        "url": "{{base}}/api/main/methods/get-access-tokens",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request denied at server boundary\", function () { pm.expect([401, 403]).to.include(pm.response.code); });"
            ]
          }
        }
      ]
    }
  ]
}
